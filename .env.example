# Copia este archivo como .env.local y ajústalo. Nunca subas .env.local al repositorio.

# La API se conecta con el rol portal_api (sujeto a RLS). NUNCA con el dueño de las tablas.
# Puerto de la base de datos en tu máquina (lo leen `pnpm db:up` y DATABASE_URL). El normal es 5432; en Windows a veces está reservado.
POSTGRES_PORT=5432
DATABASE_URL=postgres://portal_api:portal_api_dev@127.0.0.1:5432/portal

# Solo para `pnpm db:seed` (alta de la organización y carga de usuarios): el dueño de las tablas.
DATABASE_ADMIN_URL=postgres://postgres:portal_dev@127.0.0.1:5432/portal

# Organización que crea `pnpm db:seed`.
PORTAL_ORG_SLUG=portal
PORTAL_ORG_NAME=Portal

# Firma de las sesiones. Obligatoria en producción: openssl rand -base64 48
AUTH_SECRET=

# Correo (restablecer contraseña)
RESEND_API_KEY=
RESEND_FROM=Portal <onboarding@resend.dev>
APP_URL=http://localhost:3000

# ImageKit (imágenes y videos): panel de ImageKit › Developer options. La clave privada solo la usa el servidor.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# Tiempo real: puerto del servidor de WebSockets, y (opcional) Redis para correr VARIAS instancias detrás de un balanceador.
# En producción detrás de un proxy: REALTIME_URL=wss://tu-dominio/ws
REALTIME_PORT=3001
# REDIS_URL=redis://127.0.0.1:6379
