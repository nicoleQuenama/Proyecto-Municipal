# Copia este archivo como .env.local y ajústalo. Nunca subas .env.local al repositorio.

# ───────────────────────── BASE DE DATOS: elige UNA de las dos opciones ─────────────────────────
# Hay dos conexiones: DATABASE_URL (la APP: usuario portal_api, sujeto a las reglas de seguridad por fila; NUNCA el dueño) y
# DATABASE_ADMIN_URL (el DUEÑO de las tablas: solo para `pnpm db:setup`, `db:seed` y `maintenance`). Se cambian las dos juntas.

# OPCIÓN 1 — Postgres en Docker (`pnpm db:up`): lo que viene activo abajo.
#   · POSTGRES_PORT es el puerto que Docker abre en tu máquina; debe ser el MISMO que el de las dos URLs.
#   · El normal es 5432; en Windows a veces está reservado y funciona, p. ej., 55433.
#   · La contraseña del usuario postgres de Docker es `portal_dev` (la fija db/docker-compose.yml).
POSTGRES_PORT=5432
DATABASE_URL=postgres://portal_api:portal_api_dev@127.0.0.1:5432/portal
DATABASE_ADMIN_URL=postgres://postgres:portal_dev@127.0.0.1:5432/portal

# OPCIÓN 2 — TU Postgres (el que ves en pgAdmin, instalado en tu equipo o en un servidor). Comenta las tres líneas de la opción 1
#   y descomenta estas, con TU contraseña de postgres y TU puerto (normalmente 5432). Antes crea la base vacía en pgAdmin
#   (Databases › Create › Database… › portal) y luego corre `pnpm db:setup`. portal_api no hay que crearlo: lo crea db:setup con la
#   contraseña que pongas aquí. No hace falta `pnpm db:up` ni POSTGRES_PORT.
# DATABASE_URL=postgres://portal_api:UNA_CLAVE_PARA_LA_APP@127.0.0.1:5432/portal
# DATABASE_ADMIN_URL=postgres://postgres:TU_CLAVE_DE_POSTGRES@127.0.0.1:5432/portal

# OPCIÓN 3 — Supabase (base compartida por TODO el equipo). En Supabase › Project Settings › Database copia las dos URLs del
#   «Connection pooling»: la de sesión (puerto 5432) para ADMIN y la de transacciones (puerto 6543) para la app. Los usuarios
#   llevan el sufijo del proyecto (postgres.<ref>, portal_api.<ref>): db:setup crea el rol real (portal_api) con la contraseña
#   que pongas en DATABASE_URL. Solo quien crea/actualiza la base necesita ADMIN; el resto del equipo solo DATABASE_URL.
#   La contraseña es la de la base de datos (botón «Reset database password»), no la del panel. Si tiene caracteres raros,
#   codifícala en la URL (percent-encoding).
# DATABASE_URL=postgres://portal_api.TU_REF:UNA_CLAVE_PARA_LA_APP@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_ADMIN_URL=postgres://postgres.TU_REF:TU_CLAVE_DE_SUPABASE@aws-0-REGION.pooler.supabase.com:5432/postgres

# Organización que crea `pnpm db:setup` (el slug lleva de 3 a 40 letras minúsculas, números o guiones).
PORTAL_ORG_SLUG=portal
PORTAL_ORG_NAME=Portal

# Firma de las sesiones. Obligatoria en producción.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# ───────────────────────── CORREO / SMTP ─────────────────────────
# Se usa para el enlace de «olvidé mi contraseña» y para las contraseñas
# temporales que genera un superadministrador.
# Sin SMTP_HOST la app funciona, pero no envía correos.
#
# EJEMPLO GMAIL (copia, reemplaza la cuenta y descomenta en .env.local):
#   1. Activa la verificación en dos pasos en la cuenta de Google.
#   2. Crea una «Contraseña de aplicación» de 16 caracteres en:
#      https://myaccount.google.com/apppasswords
#   3. Rellena las variables así:
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM=Portal <tucuenta@gmail.com>
#
# SMTP_PASS NO es la contraseña normal de la cuenta: es la contraseña de
# aplicación (16 letras/números, sin espacios). SMTP_USER y SMTP_PASS deben
# definirse juntos; si falta uno, el servidor responde "530 Authentication
# Required" o "535 Authentication failed".
#
# Guarda SMTP_PASS sin mostrarla en pantalla:  pnpm mail:setup
# Comprueba conexión y credenciales:           pnpm mail:test
#
# Otros proveedores:
#   · Outlook/Microsoft 365: smtp.office365.com, puerto 587, SMTP_SECURE=false
#   · Hosting/cPanel: el host, puerto y correo que te dio el proveedor.
# SMTP_FROM debe ser una dirección autorizada por el servidor de correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portal <no-reply@tudominio.com>

# URL pública del portal: se usa para armar el enlace del correo.
# En producción debe ser https://tu-dominio.com (no localhost).
APP_URL=http://localhost:3000

# ImageKit (imágenes y videos): panel de ImageKit › Developer options. La clave privada solo la usa el servidor.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# Tiempo real: puerto del servidor de WebSockets, y (opcional) Redis para correr VARIAS instancias detrás de un balanceador.
# En producción detrás de un proxy: REALTIME_URL=wss://tu-dominio/ws
REALTIME_PORT=3001
# REDIS_URL=redis://127.0.0.1:6379

# SOLO DESARROLLO LOCAL con Sophos: si su escaneo SSL rompe ImageKit o la base de
# datos («unable to verify the first certificate»), esta línea desactiva la
# verificación TLS de TODO el proceso. Es INSEGURO y NUNCA debe usarse en producción.
# Lo correcto es excluir los dominios del escaneo SSL o instalar la CA de Sophos:
# NODE_EXTRA_CA_CERTS=/ruta/a/sophos-ca.pem
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Cifra las claves guardadas en la base de datos (cabeceras de APIs, servidores de despliegue). Obligatoria en producción y NO se
# puede cambiar después sin volver a guardar esas claves: openssl rand -base64 32
DATA_KEY=
