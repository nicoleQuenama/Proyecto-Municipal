# Copia este archivo como .env.local y ajústalo. Nunca subas .env.local al repositorio.

# ───────────────────────── BASE DE DATOS: elige UNA de las dos opciones ─────────────────────────
# Hay dos conexiones: DATABASE_URL (la APP: usuario portal_api, sujeto a las reglas de seguridad por fila; NUNCA el dueño) y
# DATABASE_ADMIN_URL (el DUEÑO de las tablas: solo para `pnpm db:setup`, `db:seed` y `maintenance`). Se cambian las dos juntas.

# OPCIÓN 1 — Postgres en Docker (`pnpm db:up`): lo que viene activo abajo.
#   · POSTGRES_PORT es el puerto que Docker abre en tu máquina; debe ser el MISMO que el de las dos URLs.
#   · El normal es 5432; en Windows a veces está reservado y funciona, p. ej., 55433.
#   · La contraseña del usuario postgres de Docker es `portal_dev` (la fija db/docker-compose.yml).
POSTGRES_PORT=5432
DATABASE_URL=postgres://portal_api:portal_api_dev@127.0.0.1:5432/portal
DATABASE_ADMIN_URL=postgres://postgres:portal_dev@127.0.0.1:5432/portal

# OPCIÓN 2 — TU Postgres (el que ves en pgAdmin, instalado en tu equipo o en un servidor). Comenta las tres líneas de la opción 1
#   y descomenta estas, con TU contraseña de postgres y TU puerto (normalmente 5432). Antes crea la base vacía en pgAdmin
#   (Databases › Create › Database… › portal) y luego corre `pnpm db:setup`. portal_api no hay que crearlo: lo crea db:setup con la
#   contraseña que pongas aquí. No hace falta `pnpm db:up` ni POSTGRES_PORT.
# DATABASE_URL=postgres://portal_api:UNA_CLAVE_PARA_LA_APP@127.0.0.1:5432/portal
# DATABASE_ADMIN_URL=postgres://postgres:TU_CLAVE_DE_POSTGRES@127.0.0.1:5432/portal

# Organización que crea `pnpm db:setup` (el slug lleva de 3 a 40 letras minúsculas, números o guiones).
PORTAL_ORG_SLUG=portal
PORTAL_ORG_NAME=Portal

# Firma de las sesiones. Obligatoria en producción: openssl rand -base64 48
AUTH_SECRET=

# Correo (restablecer contraseña)
RESEND_API_KEY=
RESEND_FROM=Portal <onboarding@resend.dev>
APP_URL=http://localhost:3000

# ImageKit (imágenes y videos): panel de ImageKit › Developer options. La clave privada solo la usa el servidor.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# Tiempo real: puerto del servidor de WebSockets, y (opcional) Redis para correr VARIAS instancias detrás de un balanceador.
# En producción detrás de un proxy: REALTIME_URL=wss://tu-dominio/ws
REALTIME_PORT=3001
# REDIS_URL=redis://127.0.0.1:6379

# Cifra las claves guardadas en la base de datos (cabeceras de APIs, servidores de despliegue). Obligatoria en producción y NO se
# puede cambiar después sin volver a guardar esas claves: openssl rand -base64 32
DATA_KEY=
