{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-strip-types scripts/run.mjs dev",
    "dev:web": "next dev",
    "realtime": "node --experimental-strip-types --env-file-if-exists=.env.local realtime/server.mts",
    "build": "next build",
    "start": "node --experimental-strip-types scripts/run.mjs start",
    "lint": "eslint",
    "test": "vitest run",
    "db:up": "docker compose --env-file .env.local -f db/docker-compose.yml up -d",
    "db:setup": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/db-setup.mts",
    "maintenance": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/maintenance.mts",
    "org:create": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/org-create.mts",
    "db:seed": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/db-seed.mts",
    "mail:test": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/mail-test.mts",
    "mail:setup": "node --env-file-if-exists=.env.local scripts/set-smtp-pass.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@imagekit/next": "^2.1.6",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/browser": "^4.3.3",
    "basic-ftp": "^6.2.5",
    "chart.js": "^4.6.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.1",
    "monaco-editor": "^0.57.0",
    "next": "16.4.2",
    "nodemailer": "^10.5.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.31",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.3.1",
    "sharp": "^0.35.5",
    "ssh2-sftp-client": "^12.1.1",
    "sucrase": "^3.35.1",
    "swipe": "^1.7.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/babel__generator": "^7.27.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.1.2"
}